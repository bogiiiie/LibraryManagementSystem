<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<connectionStrings>
		<add name="LibraryDB"
             connectionString="Data Source=|DataDirectory|\App_Data\LibraryDB.db;Version=3;"
             providerName="System.Data.SQLite" />
	</connectionStrings>
</configuration>